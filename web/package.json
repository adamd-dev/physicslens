{
  "name": "physicslens-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:landing": "vite build -c vite.landing.config.ts && vite build -c vite.landing.config.ts --ssr src/landing/server.tsx --outDir dist-landing-ssr --emptyOutDir && node scripts/prerender.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.9"
  },
  "overrides": {
    "rollup": "4.24.0"
  },
  "engines": {
    "node": ">=20"
  }
}
