# Copy to .env and fill in. .env is gitignored: never commit a real key.

# Meta Model API key: Muse Spark (the checking agent) and SAM 3.1 (the ball tracker).
# Without it, the motion and colour trackers and the SciPy fits still work.
MODEL_API_KEY=

# Total spend allowed, in US dollars, summed over costs.csv (default 5).
PHYSICSLENS_MAX_USD=10

# --- Running it as a public site (deploy/tunnel.sh sets the first three) ---
# PHYSICSLENS_PUBLIC=1              # shared History, upload notice, per-visitor limits
# PHYSICSLENS_MAX_UPLOAD_MB=100
# PHYSICSLENS_MAX_UPLOADS=40        # newest videos kept
# PHYSICSLENS_ADMIN_TOKEN=          # long random string; send it as X-Admin-Token to delete runs
# PHYSICSLENS_RATE_ANALYZE=6        # analyses per visitor per hour
# PHYSICSLENS_RATE_UPLOAD=12        # uploads per visitor per hour

# --- Small machines ---
# PHYSICSLENS_MAX_FRAMES=1200       # longest window, in frames
# PHYSICSLENS_MAX_WIDTH=960         # frames are shrunk to this width

# --- Server ---
# PHYSICSLENS_HOST=127.0.0.1
# PHYSICSLENS_PORT=8000
